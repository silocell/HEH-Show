{
  "manifest_version": 3,
  "name": "CTube for YouTube",
  "version": "1.0.0",
  "description": "Chausima's look for YouTube, plus a focus mode for schoolwork. Not made by, or connected with, YouTube or Google.",
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "CTube for YouTube", "default_icon": { "16": "icon16.png", "48": "icon48.png" } },
  "permissions": ["storage"],
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
    "css": ["ctube.css"],
    "js": ["apps.js", "ctube.js"],
    "run_at": "document_start"
  }]
}
